{
    "layer": "top",
    "position": "top",
    
    "margin-top": 8,
    "margin-left": 8,
    "margin-right": 8,
    "margin-bottom": 4,
    "spacing": 4,

    "modules-left": [ "hyprland/workspaces" ], 
    "modules-center": [ "clock" ],
    "modules-right": [ "pulseaudio", "bluetooth", "network", "fcitx5","tray" ],

    "hyprland/workspaces": {
        "format": "{id}",
        "all-outputs": true,
        "active-only": false,
        "on-click": "hyprctl dispatch workspace {id}",
        "persistent-workspaces": {
            "*" : 5
        }
    },

    "clock": {
        "interval": 1,
        "format": "{:%Y/%m/%d (%a) %H:%M:%S}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>"
    },

    "pulseaudio": {
        "format": "{volume}% {icon}",
        "format-muted": "󰝟 Muted", 
        "format-icons": {
            "default": [ "", "" ]
        },
        "exec": "wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{print int($2*100)}'",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
        "scroll-step": 5
    },
    
    "bluetooth": {
        "format": " {status}",
        "format-connected": " {device_alias}",
        "on-click": "blueman-manager",
        "on-click-right": "rfkill toggle bluetooth",
        "tooltip-format": "{num_connections} connected"
    },

    "network": {
        "interface": "en*",
        "interval": 1,
 	"format-ethernet": "󰈀 {ifname}", // "format-ethernet": "󰈀 {ifname}  {bandwidthDownBits}  {bandwidthUpBits}",
        "format-disconnected": "󰖪 Disconnected",
        "max-length": 25
    },

    "tray": {
        "icon-size": 18,
        "spacing": 10
    }
}
